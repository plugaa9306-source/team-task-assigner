//  Apps Script - שיבוץ משימה / דוח 1 / צפי הגעה
//
//  הפעולות (action) ב-doPost:
//    login               - ללא טוקן, מחזיר טוקן חתום + הרשאות
//    getSoldiers         - כל משתמש מחובר
//    getReportOptions    - דורש canReport1
//    getReportView       - צפייה בדיווחים (קריאה בלבד): דורש canView1, ובמחלקות המותרות בלבד.
//                          בלי date: הדיווח האחרון של כל מחלקה (לכל מחלקה התאריך שלה); עם date: תאריך מסוים.
//                          לכל חייל מוחזרת גם ההערה האחרונה (note).
//                          עם status (קוד / '*' כולם / '__unreported' / '__other') מוחזרת גם people:
//                          כל החיילים עם הסטטוס הזה בכל המחלקות שמותר לצפות בהן
//
//  הערות: שורת דיווח יכולה לכלול note. ההערה נשמרת בעמודה "הערות" שנשארת תמיד העמודה האחרונה
//  בלשונית המחלקה (עמודת תאריך חדשה נכנסת לפניה), וערך חדש דורס את הקודם (גם ערך ריק).
//  שורה בלי השדה note לא משנה את ההערה הקיימת.
//    submitMatzalReport  - דורש canReport1 + canUpdate1 (לשני סוגי הדיווח: דוח 1 וצפי הגעה),
//                          ובנוסף המחלקה המדווחת חייבת להיות מותרת למשתמש (ראו להלן)
//
//  עמודות canUpdate1 ו-canView1 בגיליון ההרשאות (אותם כללים לשתיהן):
//    TRUE (או כן / 1)         - כל המחלקות
//    FALSE / ריק              - אין הרשאה בכלל
//    שם מחלקה או רשימה        - רק במחלקות שצוינו, מופרדות בפסיק (למשל: מחלקה 1, מחלקה 2).
//                               בקשה למחלקה אחרת נדחית בשגיאת הרשאה
//
//  שגיאות מחזירות תמיד { success:false, error } ובנוסף:
//    isAuthError: true        - אין/פג/לא תקין טוקן (האפליקציה מתנתקת)
//    isPermissionError: true  - המשתמש מחובר אך חסרה לו הרשאה (האפליקציה לא מתנתקת)
//
//  שורות שנדחו בדיווח מוחזרות ב-skipped כרשימה של { name, reason, message }:
//    empty_name | empty_status | invalid_status
//  אם המערכת עסוקה (נעילה) התשובה כוללת isBusy: true - אפשר לנסות שוב.
//
//  הפעלה ראשונה: להריץ פעם אחת את setupTokenSecret(), authorizeScopes() ו-installCacheTriggers(),
//  ואז Deploy > Manage deployments > New version.
//  אחרי עריכה בגיליונות: installCacheTriggers() מנקה את המטמון אוטומטית (או clearCaches() ידנית).
// =====================================================================

// ===== הגדרות =====
